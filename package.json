{
  "name": "dsh-editor",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "prepare:desktop-runtime": "pnpm build && node scripts/prepare-desktop-runtime.mjs",
    "pack:desktop": "pnpm prepare:desktop-runtime && pnpm --filter @dsh-editor/desktop exec electron-builder --config electron-builder.yml --publish never && node scripts/verify-desktop-package.mjs",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "render:icon": "node scripts/render-app-icon.mjs",
    "upgrade:dsh": "node scripts/upgrade-dsh.mjs",
    "test:e2e:desktop": "node e2e/desktop.mjs",
    "test:e2e:core-loop": "pnpm build && node scripts/prepare-desktop-dev.mjs && node e2e/core-loop.mjs",
    "test:e2e:composition": "pnpm build && node scripts/prepare-desktop-dev.mjs && node e2e/compositions.mjs",
    "test:e2e:matrix": "pnpm build && pnpm pack:plugins && node e2e/plugin-matrix.mjs",
    "test:e2e:missing-private": "pnpm build && node scripts/prepare-desktop-dev.mjs && node e2e/missing-private-plugin.mjs",
    "test:e2e:portable": "node e2e/portable.mjs",
    "verify:desktop": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e:desktop && pnpm test:e2e:core-loop",
    "verify:delivery": "pnpm verify:desktop && pnpm test:e2e:matrix && pnpm test:e2e:missing-private && pnpm pack:desktop && pnpm test:e2e:portable",
    "publish:plugins": "node scripts/publish-npm-plugins.mjs",
    "test:e2e:ai-plugins:standalone": "pnpm build && node scripts/prepare-desktop-dev.mjs && pnpm pack:plugins && node e2e/ai-plugins-standalone.mjs",
    "test:e2e:writing-routes": "node e2e/writing-model-routes.mjs",
    "test:e2e:writing-shortcuts": "pnpm build && node scripts/prepare-desktop-dev.mjs && node e2e/writing-shortcuts.mjs",
    "test:external-plugins": "node --test scripts/external-plugins.test.mjs",
    "test:e2e:editor-models": "node e2e/writing-model-routes.mjs --editor-models",
    "test:e2e:writing-models": "pnpm build && node scripts/prepare-desktop-dev.mjs && node e2e/writing-models.mjs",
    "test:e2e:on-demand-plugins": "pnpm build && node scripts/prepare-desktop-dev.mjs && node e2e/writing-models.mjs --optional-install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "@deepseek-ai/dsh-anonymous-user-id": "0.2.0-rc.2",
      "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
      "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
      "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
      "@deepseek-ai/dsh-deepseek-account": "0.2.0-rc.2",
      "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
      "@deepseek-ai/dsh-hook-protocol": "0.2.0-rc.2",
      "@deepseek-ai/dsh-jobs": "0.2.0-rc.2",
      "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.2",
      "@deepseek-ai/dsh-output-retention": "0.2.0-rc.2",
      "@deepseek-ai/dsh-sdk-protocol": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-telemetry": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-title-llm": "0.2.0-rc.2",
      "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
      "@deepseek-ai/dsh-spill": "0.2.0-rc.2",
      "@deepseek-ai/dsh-subagent-in-process-driver": "0.2.0-rc.2",
      "@deepseek-ai/dsh-util-time": "0.2.0-rc.2",
      "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
      "@deepseek-ai/dsh-workflow": "0.2.0-rc.2",
      "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
      "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
      "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
      "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
      "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
      "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
      "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
      "@deepseek-ai/dsh-compaction-image-offload": "0.2.0-rc.2",
      "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-format": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-format-catalog": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-format-v0-to-v1": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-format-v1-to-v2": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-format-v2-to-v3": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-projection-cache": "0.2.0-rc.2",
      "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
      "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
      "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
      "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2",
      "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
      "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.2",
      "@deepseek-ai/dsh-web-search-deepseek": "0.2.0-rc.2",
      "@deepseek-ai/dsh-web-search-exa": "0.2.0-rc.2",
      "playwright": "1.62.1"
    },
    "patchedDependencies": {
      "@deepseek-ai/dsh-client-ui-plugin-manager@0.2.0-rc.2": "patches/@deepseek-ai__dsh-client-ui-plugin-manager@0.2.0-rc.2.patch",
      "@deepseek-ai/dsh-client-ui-primitives@0.2.0-rc.2": "patches/@deepseek-ai__dsh-client-ui-primitives@0.2.0-rc.2.patch",
      "@deepseek-ai/dsh-web-frontend@0.2.0-rc.2": "patches/@deepseek-ai__dsh-web-frontend@0.2.0-rc.2.patch"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@klarkxy/dsh-web-search-manager": "0.1.11",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "playwright": "^1.62.1",
    "proper-lockfile": "4.1.2",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
