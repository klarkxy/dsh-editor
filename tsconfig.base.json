{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "dsh-manuscript/host-api": ["packages/dsh-manuscript/src/host-api.ts"],
      "dsh-editor-workbench/contracts": ["packages/dsh-editor-workbench/src/contracts.ts"],
      "dsh-editor-novel-kernel/contracts": ["packages/dsh-editor-novel-kernel/src/contracts.ts"]
    }
  }
}
