{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "作者确认后写入正文（writing_propose V2）",
    "output": "author-confirm-write.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1280, 580],
    "legend": {
      "mode": "auto",
      "entries": {
        "default": { "label": "调用" },
        "emphasis": { "label": "主路径" },
        "security": { "label": "写入门禁" },
        "dashed": { "label": "只读预览" },
        "return": { "label": "返回" }
      }
    },
    "views": [
      {
        "id": "send-plain",
        "label": "发送纯文本",
        "focus": ["author", "shell", "dsh"],
        "note": "四个写作 Preset 发送原始用户文本，不走 context.compile，不自动拼入资料。"
      },
      {
        "id": "preview-proposal",
        "label": "预览提案",
        "focus": ["dsh", "workbench", "shell"],
        "note": "writing_propose 只返回 marker，不写文件。Workbench 是同一 DSH 进程内的插件。"
      },
      {
        "id": "author-write",
        "label": "确认写入",
        "focus": ["author", "shell", "manuscript", "workspace"],
        "note": "作者确认后才走 proposal.apply；拆章 / 合章 / 批量重命名改走 workbench。"
      }
    ]
  },
  "participants": [
    { "id": "author", "type": "external", "label": "作者", "sublabel": "确认写入" },
    { "id": "shell", "type": "frontend", "label": "Shell", "sublabel": "root GUI" },
    { "id": "dsh", "type": "cloud", "label": "DSH Session", "sublabel": "唯一 Agent" },
    { "id": "workbench", "type": "backend", "label": "Workbench", "sublabel": "writing_propose 工具" },
    { "id": "manuscript", "type": "backend", "label": "Manuscript", "sublabel": "同进程 /manuscript" },
    { "id": "workspace", "type": "database", "label": "作品目录", "sublabel": "replaceIfVersion" }
  ],
  "segments": [
    { "from": 148, "to": 240, "label": "发送纯文本" },
    { "from": 252, "to": 340, "label": "预览提案" },
    { "from": 372, "to": 512, "label": "确认写入" }
  ],
  "messages": [
    { "id": "author-send", "from": "author", "to": "shell", "y": 168, "label": "发送写作请求", "variant": "emphasis" },
    { "id": "session-prompt", "from": "shell", "to": "dsh", "y": 204, "label": "session.prompt（纯文本）", "variant": "emphasis" },
    { "id": "writing-propose", "from": "dsh", "to": "workbench", "y": 276, "label": "writing_propose V2", "variant": "dashed" },
    { "id": "marker-return", "from": "workbench", "to": "dsh", "y": 308, "label": "proposal marker", "variant": "return" },
    { "id": "snapshot", "from": "dsh", "to": "shell", "y": 336, "label": "ConversationSnapshot", "variant": "return" },
    { "id": "confirm-write", "from": "author", "to": "shell", "y": 400, "label": "确认写入", "variant": "emphasis" },
    { "id": "proposal-apply", "from": "shell", "to": "manuscript", "y": 436, "label": "proposal.apply（带版本基线）", "variant": "security" },
    { "id": "replace-version", "from": "manuscript", "to": "workspace", "y": 468, "label": "createIfAbsent / replaceIfVersion", "variant": "security" },
    { "id": "buffer-updated", "from": "shell", "to": "author", "y": 496, "label": "稿纸已更新", "variant": "return" }
  ],
  "activations": [
    { "participant": "shell", "from": 163, "to": 500, "type": "frontend" },
    { "participant": "dsh", "from": 199, "to": 341, "type": "cloud" },
    { "participant": "workbench", "from": 271, "to": 315, "type": "backend" },
    { "participant": "manuscript", "from": 431, "to": 475, "type": "backend" },
    { "participant": "workspace", "from": 463, "to": 480, "type": "database" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "同进程协作",
      "items": [
        "Workbench、Manuscript 都是这份 DSH Host 里的插件",
        "泳道分开只为读调用顺序，不表示独立服务",
        "DshChatPort 只投影 SessionFace，不自己跑工具"
      ]
    },
    {
      "dot": "amber",
      "title": "预览不写盘",
      "items": [
        "writing_propose V2 只返回 marker",
        "作者确认前正文不变",
        "拆章 / 合章 / 批量重命名走 workbench proposal"
      ]
    },
    {
      "dot": "rose",
      "title": "写入门禁",
      "items": [
        "edit / split 带生成时 Host-read 的 targetVersion；merge 加 sourceVersion；renames 每项 version",
        "create 严格 create-if-absent；basis 不能代替目标基线",
        "目标变了就 STALE，冲突时保留编辑 buffer"
      ]
    }
  ]
}
