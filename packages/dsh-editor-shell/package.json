{
  "name": "dsh-editor-shell",
  "version": "0.1.0",
  "description": "Private manuscript-first DSH client shell",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./seats": {
      "types": "./lib/seats.d.ts",
      "import": "./lib/seats.js",
      "default": "./lib/seats.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-typert-registry",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dshEditor": {
    "role": "core",
    "visibility": "desktop",
    "wrapClient": true,
    "entries": [
      {
        "id": "editor-shell",
        "title": "写作界面",
        "description": "三栏稿纸与设置",
        "locked": true
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs dsh-editor-shell",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-editor-shell/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@types/react": "18.3.31",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "dsh-manuscript": "workspace:*",
    "dsh-editor-seats": "workspace:*",
    "dsh-editor-workbench": "workspace:*",
    "dsh-editor-novel-kernel": "workspace:*",
    "dsh-editor-cards": "workspace:*"
  },
  "private": true
}
