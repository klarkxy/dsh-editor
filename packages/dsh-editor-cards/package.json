{
  "name": "dsh-editor-cards",
  "version": "0.1.0",
  "description": "Character and worldbook cards Host RPC and Client UI for DSH Editor",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./host-api": {
      "types": "./lib/host-api.d.ts",
      "import": "./lib/host-api.js",
      "default": "./lib/host-api.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "desktop",
    "wrapClient": true,
    "entries": [
      {
        "id": "editor-cards",
        "title": "人物卡与世界书",
        "description": "卡片列表、frontmatter 编辑、引用导航与新建",
        "feature": "cards"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs dsh-editor-cards",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-editor-cards/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "dsh-editor-workspace-kit": "workspace:*",
    "dsh-manuscript": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/react": "18.3.31",
    "dsh-editor-seats": "workspace:*",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
