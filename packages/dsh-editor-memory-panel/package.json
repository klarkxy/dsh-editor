{
  "name": "dsh-editor-memory-panel",
  "version": "0.1.0",
  "description": "Project memory maintenance sidebar for the DSH Editor shell",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "desktop",
    "wrapClient": true,
    "entries": [
      {
        "id": "editor-memory-panel",
        "title": "记忆维护",
        "description": "查看、应用与撤销写作搭档提出的 AGENTS.md / 人物卡 / 世界书维护记录",
        "feature": "memory-panel"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs dsh-editor-memory-panel",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-editor-memory-panel/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/react": "18.3.31",
    "dsh-editor-seats": "workspace:*",
    "dsh-editor-workbench": "workspace:*",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
