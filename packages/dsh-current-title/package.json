{
  "name": "@klarkxy/dsh-current-title",
  "version": "0.1.0",
  "description": "Session titles from the latest human task, using DSH native title storage",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "public",
    "wrapClient": true,
    "entries": [
      {
        "id": "current-title",
        "title": "当前标题",
        "description": "按最近人工消息更新会话标题",
        "feature": "current-title",
        "service": "currentTitle"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs @klarkxy/dsh-current-title",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-current-title/src"
  },
  "dependencies": {
    "@klarkxy/dsh-ai-services": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-rc.2",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0",
    "@types/react": "18.3.31"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-title"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-editor.git",
    "directory": "packages/dsh-current-title"
  },
  "homepage": "https://github.com/klarkxy/dsh-editor/tree/main/packages/dsh-current-title#readme",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-editor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
