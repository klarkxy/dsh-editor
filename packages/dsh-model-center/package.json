{
  "name": "@klarkxy/dsh-model-center",
  "version": "0.1.0",
  "description": "Configure model tiers, provider connections, and AI call limits for DeepSeek Harness.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "public",
    "wrapClient": true,
    "entries": [
      {
        "id": "model-center",
        "title": "模型中心",
        "description": "按功能选择模型并管理供应商连接",
        "feature": "model-center",
        "service": "modelCenter"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs @klarkxy/dsh-model-center",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-model-center/src"
  },
  "dependencies": {
    "@klarkxy/dsh-ai-services": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "react": "^18.2.0",
    "@types/react": "18.3.31"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-center",
    "model-routing",
    "model-settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-editor.git",
    "directory": "packages/dsh-model-center"
  },
  "homepage": "https://github.com/klarkxy/dsh-editor/tree/main/packages/dsh-model-center#readme",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-editor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "sha256-47d9c130265a95bf1b0dd3ca88b59d4eda74ce10511fc6f9a5027243e078bae8"
  }
}
