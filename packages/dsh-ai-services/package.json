{
  "name": "@klarkxy/dsh-ai-services",
  "version": "0.1.2",
  "description": "Shared model routing, bounded auxiliary calls, and usage receipts for DeepSeek Harness plugins.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./host-rpc": {
      "types": "./lib/host-rpc.d.ts",
      "import": "./lib/host-rpc.js",
      "default": "./lib/host-rpc.js"
    },
    "./package.json": "./package.json",
    "./client-utils": {
      "types": "./lib/client-utils.d.ts",
      "import": "./lib/client-utils.js",
      "default": "./lib/client-utils.js"
    },
    "./insert-output": {
      "types": "./lib/insert-output.d.ts",
      "import": "./lib/insert-output.js",
      "default": "./lib/insert-output.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshEditor": {
    "role": "core",
    "visibility": "public",
    "entries": [
      {
        "id": "ai-services",
        "title": "AI 服务",
        "description": "插件共用的模型路由与有界调用，不自动发起推理",
        "locked": true,
        "service": "aiServices"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-ai-services/src"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-rc.2",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0",
    "@types/react": "18.3.31"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "ai-services",
    "model-routing",
    "usage-receipts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-editor.git",
    "directory": "packages/dsh-ai-services"
  },
  "homepage": "https://github.com/klarkxy/dsh-editor/tree/main/packages/dsh-ai-services#readme",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-editor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dshRelease": {
    "contentHash": "sha256-588bd0cf42c6a4b3154536e72b967b1bddeb6217f1ca4d4774d9754407301b90"
  }
}
