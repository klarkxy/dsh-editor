{
  "name": "dsh-manuscript",
  "version": "0.1.0",
  "description": "DSH manuscript GUI: generic workspace tree, prose editor, ghost completion",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./host-api": {
      "types": "./lib/host-api.d.ts",
      "import": "./lib/host-api.js",
      "default": "./lib/host-api.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./client/editor-core": {
      "default": "./lib/client-editor-core.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/host-api.js",
    "lib/host-api.d.ts",
    "lib/host-error.js",
    "lib/host-error.js.map",
    "lib/host-error.d.ts",
    "lib/client.js",
    "lib/client-editor-core.cjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs dsh-manuscript",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-manuscript/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
