{
  "name": "@klarkxy/dsh-memory",
  "version": "0.1.3",
  "description": "Descriptive context and Dream consolidation for DSH Web: scoped vocabulary, preferences and recent activity.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dshEditor": {
    "role": "feature",
    "visibility": "public",
    "wrapClient": true,
    "entries": [
      {
        "id": "memory",
        "title": "记忆",
        "description": "作者用语、偏好与近期状态；Dream 语境观察与整理",
        "feature": "memory",
        "service": "aiMemory"
      }
    ]
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/wrap-client.mjs @klarkxy/dsh-memory",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-memory/src"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-alpha.1",
    "@klarkxy/dsh-ai-services": "workspace:*",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "react": "^18.2.0",
    "@types/react": "18.3.31"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "dream"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/dsh-editor.git",
    "directory": "packages/dsh-memory"
  },
  "homepage": "https://github.com/klarkxy/dsh-editor/tree/main/packages/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/klarkxy/dsh-editor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dshRelease": {
    "contentHash": "sha256-f1de6f08219c862d4dc9bb4f6409d7b12960ee41b2baae17ab63a243ce4fc485"
  }
}
