{
  "name": "dsh-editor-workbench",
  "version": "0.1.0",
  "description": "Private DSH Editor project lifecycle and context Host",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json",
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js",
      "default": "./lib/tools.js"
    }
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshEditor": {
    "role": "core",
    "visibility": "desktop",
    "entries": [
      {
        "id": "editor-workbench",
        "title": "工作台",
        "description": "作品目录、概览、校对与快照",
        "locked": true
      },
      {
        "id": "editor-workbench-tools",
        "title": "作品概览工具",
        "description": "供写作搭档读取作品概览",
        "feature": "assistant"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-editor-workbench/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.2 <0.2.0"
  },
  "dependencies": {
    "dsh-editor-cards": "workspace:*",
    "dsh-editor-workspace-kit": "workspace:*",
    "dsh-manuscript": "workspace:*",
    "dsh-proofread": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
