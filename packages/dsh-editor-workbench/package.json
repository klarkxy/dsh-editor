{
  "name": "dsh-editor-workbench",
  "version": "0.1.0",
  "description": "Private DSH Editor project lifecycle and context Host",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "import": "./lib/contracts.js",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json",
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js",
      "default": "./lib/tools.js"
    }
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-editor-workbench/src"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0"
  },
  "dependencies": {
    "dsh-manuscript": "workspace:*",
    "dsh-proofread": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
